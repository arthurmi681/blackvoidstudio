{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Static site - no build needed'",
  "outputDirectory": ".",
  "framework": null,
  "installCommand": "echo 'No install needed'",
  "rewrites": [
    {
      "source": "/branding",
      "destination": "https://sistema-branding-arthurmiyazaki3-1925s-projects.vercel.app/branding"
    },
    {
      "source": "/branding/:path*",
      "destination": "https://sistema-branding-arthurmiyazaki3-1925s-projects.vercel.app/branding/:path*"
    },
    {
      "source": "/politica-de-privacidade",
      "destination": "/pages/politica-de-privacidade.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-Web|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|Google-Extended|VertexAI|Gemini|Bard|bingbot|Bingbot|[Mm][Ss][Nn][Bb]ot|Microsoft-Web-Exploration|Meta-ExternalAgent|Meta-ExternalFetcher|facebookexternalhit|Applebot|AppleBot|CohereBot|MistralBot|HuggingFaceBot|Bytespider|YouBot|DuckDuckBot|PetalBot).*"
        }
      ],
      "destination": "/pages/ia-crawler.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-Web|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|Google-Extended|VertexAI|Gemini|Bard|bingbot|Bingbot|[Mm][Ss][Nn][Bb]ot|Microsoft-Web-Exploration|Meta-ExternalAgent|Meta-ExternalFetcher|facebookexternalhit|Applebot|AppleBot|CohereBot|MistralBot|HuggingFaceBot|Bytespider|YouBot|DuckDuckBot|PetalBot).*"
        }
      ],
      "destination": "/pages/ia-crawler.html"
    },
    {
      "source": "/ia-crawler",
      "destination": "/pages/ia-crawler.html"
    },
    {
      "source": "/ia-crawler.html",
      "destination": "/pages/ia-crawler.html"
    },
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/index.html",
      "destination": "/home.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/ia-crawler.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/pages/ia-crawler.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-Web|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|Google-Extended|VertexAI|Gemini|Bard|bingbot|Bingbot|[Mm][Ss][Nn][Bb]ot|Microsoft-Web-Exploration|Meta-ExternalAgent|Meta-ExternalFetcher|facebookexternalhit|Applebot|AppleBot|CohereBot|MistralBot|HuggingFaceBot|Bytespider|YouBot|DuckDuckBot|PetalBot).*"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        },
        {
          "key": "X-Served-Content",
          "value": "ia-crawler"
        }
      ]
    }
  ]
}
