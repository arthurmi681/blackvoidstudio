{
  "agent": {
    "name": "VOID",
    "version": "1.0.0",
    "description": "Assistente de IA para Black Void Studio",
    "enabled": true
  },
  "llm": {
    "provider": "groq",
    "model": "llama3-70b-8192",
    "apiEndpoint": "https://api.groq.com/openai/v1/chat/completions",
    "temperature": 0.7,
    "maxTokens": 500,
    "retryAttempts": 3,
    "retryDelay": 1000
  },
  "behavior": {
    "language": "pt-BR",
    "personality": "direct_technical",
    "responseStyle": "concise",
    "maxResponseLength": 500,
    "useLocalCache": true,
    "enableTyping": true
  },
  "storage": {
    "localStorage": true,
    "maxHistoryItems": 50,
    "persistHistory": true
  },
  "ui": {
    "showTypingIndicator": true,
    "animationSpeed": 300,
    "theme": "dark",
    "position": "bottom-right"
  },
  "features": {
    "conversation": true,
    "suggestions": true,
    "context_awareness": true,
    "local_responses": true,
    "history": true
  }
}
